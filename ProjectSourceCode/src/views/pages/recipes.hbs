<main class="container recipe-page py-4 py-md-5">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <p class="recipe-eyebrow mb-2">PlateShare · Your recipe book</p>
      <h1 class="fw-bold mb-2">{{title}}</h1>
      <p class="text-secondary mb-0">{{#if isLibrary}}Keep your next meal close. Revisit the dishes you have rated.{{else}}Find a dish, check its nutrition, and save it for later.{{/if}}</p>
    </div>
    {{#if isLibrary}}<a class="btn btn-outline-success" href="/recipes">Browse recipes</a>{{/if}}
  </div>

  {{#if isLibrary}}
    <div class="recipe-stats mb-4" aria-label="Your recipe collection">
      <div><strong>{{stats.saved}}</strong><span>Saved recipes</span></div>
      <div><strong>{{stats.rated}}</strong><span>Recipes rated</span></div>
    </div>
    <nav class="recipe-tabs mb-4" aria-label="Recipe collections">
      <a href="{{savedUrl}}" {{#if isSaved}}class="active" aria-current="page"{{/if}}>Saved · {{stats.saved}}</a>
      <a href="{{ratedUrl}}" {{#if isRated}}class="active" aria-current="page"{{/if}}>Rated · {{stats.rated}}</a>
    </nav>
  {{/if}}

  <form method="get" action="{{base}}" class="row g-3 align-items-end mb-4" role="search">
    {{#if isLibrary}}<input type="hidden" name="view" value="{{view}}">{{/if}}
    <div class="col-12 col-md-6">
      <label class="form-label" for="recipe-search">Search by recipe or cuisine</label>
      <input class="form-control" type="search" id="recipe-search" name="q" value="{{q}}" maxlength="100" placeholder="Try pasta or Italian">
    </div>
    <div class="col-8 col-md-4">
      <label class="form-label" for="recipe-sort">Sort by</label>
      <select class="form-select" id="recipe-sort" name="sort">
        <option value="recent" {{#if recentSort}}selected{{/if}}>Most recent</option>
        <option value="title" {{#if titleSort}}selected{{/if}}>Recipe name</option>
        <option value="rating" {{#if ratingSort}}selected{{/if}}>My highest rating</option>
      </select>
    </div>
    <div class="col-4 col-md-2"><button class="btn btn-success w-100" type="submit">Apply</button></div>
  </form>

  <p class="small text-secondary">{{total}} recipes{{#if hasSearch}} matching “{{q}}”{{/if}}{{#if isRated}} · Your ratings out of 5{{/if}}</p>
  {{#if recipes.length}}
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
      {{#each recipes}}
        <div class="col">{{> recipe-card recipe=this csrfToken=@root.csrfToken returnTo=@root.returnTo}}</div>
      {{/each}}
    </div>
    {{> recipe-pagination}}
  {{else}}
    <section class="recipe-empty text-center p-4 p-md-5">
      {{#if hasSearch}}
        <h2 class="h4">No matching recipes</h2>
        <p class="text-secondary">Try another recipe name or cuisine.</p>
        <a class="btn btn-outline-success" href="{{base}}{{#if isLibrary}}?view={{view}}{{/if}}">Clear search</a>
      {{else if isLibrary}}
        <h2 class="h4">{{#if isRated}}No rated recipes yet{{else}}No saved recipes yet{{/if}}</h2>
        <p class="text-secondary">{{#if isRated}}Recipes you rate will appear here, even if you have not saved them.{{else}}Save a recipe to start your personal collection.{{/if}}</p>
        <a class="btn btn-success" href="/recipes">Browse recipes</a>
      {{else}}
        <h2 class="h4">No recipes yet</h2>
        <p class="text-secondary mb-0">Recipes will appear here once they have been added to PlateShare.</p>
      {{/if}}
    </section>
  {{/if}}
</main>
