<main class="container recipe-page py-4 py-md-5">
  <p class="recipe-eyebrow">The people behind the plates</p>
  <h1>Good taste brings us together.</h1>
  <p class="text-secondary">Find friends, discover new cooks, and see what they’re making.</p>
  <form action="/discover" method="GET" class="cook-search" role="search" aria-label="Find cooks">
    <label for="cook-search" class="form-label">Search by username</label>
    <div class="input-group">
      <input type="search" name="q" id="cook-search" class="form-control" placeholder="Find a cook…" value="{{query}}">
      <button type="submit" class="btn btn-success">Search</button>
    </div>
  </form>
  {{#if error}}<div class="alert alert-danger" role="alert">{{message}}</div>{{/if}}
  <div class="cook-list">
    {{#each profiles}}
      <a href="/profile/{{this.username}}" class="cook-card">
        <span class="profile-avatar" aria-hidden="true">{{> icon person=true}}</span>
        <div class="cook-card-name"><strong>{{this.username}}</strong>{{#if this.is_private}}<span class="profile-status ms-2">Private</span>{{/if}}</div>
        <span class="cook-card-action">View profile</span>
      </a>
    {{else}}
      <section class="recipe-empty p-4"><h2 class="h5">No users found.</h2><p class="text-secondary mb-0">Try another username to find someone’s kitchen.</p></section>
    {{/each}}
  </div>
</main>
