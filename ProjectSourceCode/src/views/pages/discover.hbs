<main class="container recipe-page discover-page py-4">
  <div class="discover-heading">
    <div><p class="recipe-eyebrow mb-1">Fresh from the community</p><h1>Discover</h1></div>
    <a class="btn btn-outline-success btn-sm" href="/recipes">Search recipes</a>
  </div>
  <p class="text-secondary mb-4">Your next great meal is a scroll away.</p>
  <section data-discover-feed aria-label="Recipe feed">
    {{> discover-batch}}
  </section>
  <p class="discover-status text-secondary" data-feed-status role="status"></p>
  <noscript><p>Use “Load more recipes” to continue browsing.</p></noscript>
</main>
<script src="/resources/js/discover.js" defer></script>
