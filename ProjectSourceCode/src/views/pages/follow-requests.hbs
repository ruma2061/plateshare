
<div class="container mt-4">

  <h2>Follow Requests</h2>

  <div class="list-group mt-3">

    {{#each requests}}
      <div class="list-group-item">

        <div class="d-flex justify-content-between
                    align-items-center">

          <a href="/profile/{{this.username}}">
            {{this.username}}
          </a>

          <div class="d-flex gap-2">

            <form action="/follow/accept/{{this.user_id}}"
                  method="POST">
              <button class="btn btn-primary btn-sm"
                      type="submit">
                Accept
              </button>
            </form>

            <form action="/follow/decline/{{this.user_id}}"
                  method="POST">
              <button class="btn btn-outline-danger btn-sm"
                      type="submit">
                Decline
              </button>
            </form>

          </div>
        </div>

      </div>
    {{else}}
      <p class="text-muted">
        No pending follow requests.
      </p>
    {{/each}}

  </div>

  <a href="/profile" class="btn btn-outline-secondary mt-3">
    Back to Profile
  </a>

</div>
