<main class="container recipe-page py-4 py-md-5">
  <a class="recipe-title-link" href="/recipes">{{> icon arrow=true}} All recipes</a>
  <p class="recipe-eyebrow mt-4 mb-2">Powered by TheMealDB</p>
  <h1 class="fw-bold mb-2">Find more recipes</h1>
  <p class="text-secondary">Search TheMealDB and add any recipe to PlateShare. Imported recipes can be rated and saved like the rest.</p>

  <form method="get" action="/recipes/import" class="mb-4" role="search">
    <div class="input-group">
      <input type="search" name="q" class="form-control" placeholder="Try chicken, pasta, curry..." value="{{q}}" maxlength="100" aria-label="Search TheMealDB">
      <button type="submit" class="btn btn-success">Search</button>
    </div>
  </form>

  {{#if error}}
    <div class="alert alert-warning" role="alert">{{error}}</div>
  {{else if searched}}
    <p class="small text-secondary">{{resultLabel}} for “{{q}}”</p>
    {{#if results.length}}
      <div class="row g-4">
        {{#each results}}
          <div class="col-12 col-sm-6 col-lg-4">
            <article class="card recipe-card h-100">
              {{#if imageUrl}}<img src="{{imageUrl}}" class="card-img-top recipe-card-image" alt="" loading="lazy" referrerpolicy="no-referrer">{{/if}}
              <div class="card-body d-flex flex-column">
                <p class="recipe-eyebrow mb-2">{{#if cuisine}}{{cuisine}}{{else}}TheMealDB{{/if}}</p>
                <h2 class="h5">{{title}}</h2>
                <p class="small text-secondary">{{ingredientCount}} ingredients</p>
                <div class="mt-auto">
                  {{#if recipeId}}
                    <a class="btn btn-outline-success btn-sm" href="/recipes/{{recipeId}}">Already on PlateShare · View</a>
                  {{else}}
                    <form method="post" action="/recipes/import/{{mealdbId}}">
                      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                      <button type="submit" class="btn btn-success btn-sm">Import to PlateShare</button>
                    </form>
                  {{/if}}
                </div>
              </div>
            </article>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="text-secondary">No recipes found. Try a simpler word like “beef” or “soup”.</p>
    {{/if}}
  {{/if}}
</main>
