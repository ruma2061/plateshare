
<div class="container mt-4">
  <h2>Edit Profile</h2>
  <h5 class="mt-4">About You</h5>
  <form action="/profile/details" method="POST" class="mb-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="mb-3">
      <label for="display_name" class="form-label">Display name</label>
      <input id="display_name" name="display_name" class="form-control"
        maxlength="60" minlength="2" required
        value="{{#if profileUser.display_name}}{{profileUser.display_name}}{{else}}{{profileUser.username}}{{/if}}">
    </div>
    <div class="mb-3">
      <label for="bio" class="form-label">Bio (optional)</label>
      <textarea id="bio" name="bio" class="form-control" maxlength="280" rows="3">{{profileUser.bio}}</textarea>
    </div>
    <div class="mb-3">
      <label for="avatar_url" class="form-label">Photo URL (optional)</label>
      <input id="avatar_url" name="avatar_url" class="form-control"
        type="url" maxlength="2000" value="{{profileUser.avatar_url}}">
      <small class="text-muted">Use an HTTPS image URL.</small>
    </div>
    <button type="submit" class="btn btn-primary">Save profile</button>
  </form>


  <h5 class="mt-4">Account Privacy</h5>

  <form action="/profile/privacy" method="POST">
        <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="radio"
        name="is_private"
        id="public"
        value="false"
        {{#unless profileUser.is_private}}checked{{/unless}}
      >

      <label class="form-check-label" for="public">
        <strong>Public Account</strong>
        <p class="text-muted">
          Anyone can follow you and see your public activity.
        </p>
      </label>
    </div>

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="radio"
        name="is_private"
        id="private"
        value="true"
        {{#if profileUser.is_private}}checked{{/if}}
      >

      <label class="form-check-label" for="private">
        <strong>Private Account</strong>
        <p class="text-muted">
          New followers require approval before viewing
          your recipes and activity.
        </p>
      </label>
    </div>

    <p class="small text-muted">
      Existing followers remain approved when switching
      to private. Switching to public will approve any
      outstanding follow requests.
    </p>

    <button type="submit" class="btn btn-primary">
      Save Changes
    </button>

    <a href="/profile" class="btn btn-outline-secondary">
      Cancel
    </a>

  </form>
</div>
