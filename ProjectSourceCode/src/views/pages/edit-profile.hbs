
<div class="container recipe-page profile-settings py-4 py-md-5">
  <h2>Edit Profile</h2>
  {{#if updated}}<div class="alert alert-success" role="status">Your profile has been saved.</div>{{/if}}
  {{#if profileError}}<div class="alert alert-danger" role="alert">{{profileError}}</div>{{/if}}
  <h5 class="mt-4">About You</h5>
  <form action="/profile/details" method="POST" enctype="multipart/form-data" class="mb-4" data-profile-form>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="mb-3">
      <label for="display_name" class="form-label">Display name</label>
      <input id="display_name" name="display_name" class="form-control"
        maxlength="60" minlength="2" required
        value="{{#if profileUser.display_name}}{{profileUser.display_name}}{{else}}{{profileUser.username}}{{/if}}">
    </div>
    <div class="mb-3">
      <label for="bio" class="form-label">Bio (optional)</label>
      <textarea id="bio" name="bio" class="form-control" maxlength="280" rows="3">{{profileUser.bio}}</textarea>
    </div>
    <fieldset class="mb-4" data-profile-photo>
      <legend class="fs-6 fw-semibold">Profile photo</legend>
      <div class="profile-photo-dropzone" data-photo-dropzone>
        <div class="profile-photo-preview">
          <img data-photo-preview {{#if profileUser.avatar_url}}src="{{profileUser.avatar_url}}"{{else}}hidden{{/if}} alt="Profile photo preview">
          <span data-photo-placeholder {{#if profileUser.avatar_url}}hidden{{/if}} aria-hidden="true">{{> icon person=true}}</span>
        </div>
        <div class="profile-photo-controls">
          <p class="fw-semibold mb-1">Drag a photo here</p>
          <p id="photo-help" class="small text-muted mb-2">JPG, PNG, or WebP · Up to 5 MB. A square crop looks best.</p>
          <label for="avatar_photo" class="form-label">Choose photo</label>
          <input id="avatar_photo" name="avatar_photo" class="form-control" type="file"
            accept="image/jpeg,image/png,image/webp" aria-describedby="photo-help photo-status" data-photo-input>
          <p id="photo-status" class="small mb-0 mt-2" role="status" aria-live="polite" data-photo-status>Changes are saved when you select Save profile.</p>
        </div>
      </div>
      <label class="form-check mt-2">
        <input type="checkbox" name="remove_photo" value="1" class="form-check-input" data-photo-remove>
        <span class="form-check-label">Remove photo when saved</span>
      </label>
    </fieldset>
    <div class="mb-3">
      <label for="avatar_url" class="form-label">Or use a photo URL (optional)</label>
      <input id="avatar_url" name="avatar_url" class="form-control"
        type="url" maxlength="2000" value="{{avatarInputUrl}}" data-photo-url>
      <small class="text-muted">Use an HTTPS image URL. A selected file takes priority.</small>
    </div>
    <button type="submit" class="btn btn-primary">Save profile</button>
  </form>


  <h5 class="mt-4">Account Privacy</h5>

  <form action="/profile/privacy" method="POST">
        <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="radio"
        name="is_private"
        id="public"
        value="false"
        {{#unless profileUser.is_private}}checked{{/unless}}
      >

      <label class="form-check-label" for="public">
        <strong>Public Account</strong>
        <p class="text-muted">
          Anyone can follow you and see your public activity.
        </p>
      </label>
    </div>

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="radio"
        name="is_private"
        id="private"
        value="true"
        {{#if profileUser.is_private}}checked{{/if}}
      >

      <label class="form-check-label" for="private">
        <strong>Private Account</strong>
        <p class="text-muted">
          New followers require approval before viewing
          your recipes and activity.
        </p>
      </label>
    </div>

    <p class="small text-muted">
      Existing followers remain approved when switching
      to private. Switching to public will approve any
      outstanding follow requests.
    </p>

    <button type="submit" class="btn btn-primary">
      Save Changes
    </button>

    <a href="/profile" class="btn btn-outline-secondary">
      Cancel
    </a>

  </form>
</div>
<script src="/resources/js/profile-photo.js" defer></script>
