
<div class="container mt-4">
  <h2>Edit Profile</h2>

  <h5 class="mt-4">Account Privacy</h5>

  <form action="/profile/privacy" method="POST">

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="radio"
        name="is_private"
        id="public"
        value="false"
        {{#unless profileUser.is_private}}checked{{/unless}}
      >

      <label class="form-check-label" for="public">
        <strong>Public Account</strong>
        <p class="text-muted">
          Anyone can follow you and see your public activity.
        </p>
      </label>
    </div>

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="radio"
        name="is_private"
        id="private"
        value="true"
        {{#if profileUser.is_private}}checked{{/if}}
      >

      <label class="form-check-label" for="private">
        <strong>Private Account</strong>
        <p class="text-muted">
          New followers require approval before viewing
          your recipes and activity.
        </p>
      </label>
    </div>

    <p class="small text-muted">
      Existing followers remain approved when switching
      to private. Switching to public will approve any
      outstanding follow requests.
    </p>

    <button type="submit" class="btn btn-primary">
      Save Changes
    </button>

    <a href="/profile" class="btn btn-outline-secondary">
      Cancel
    </a>

  </form>
</div>
