  <form method="get" action="{{base}}" class="recipe-filters" role="search" aria-label="Search recipes">
    <input type="hidden" name="view" value="{{view}}">
    <div class="recipe-search-field">
      <label class="form-label" for="recipe-search">Find something delicious</label>
      <div class="search-input-wrap">{{> icon search=true}}<input class="form-control" type="search" id="recipe-search" name="q" value="{{q}}" maxlength="100" placeholder="Search recipes or cuisines"></div>
    </div>
    <div>
      <label class="form-label" for="recipe-sort">Sort by</label>
      <select class="form-select" id="recipe-sort" name="sort">
        <option value="recent" {{#if recentSort}}selected{{/if}}>Most recent</option>
        <option value="title" {{#if titleSort}}selected{{/if}}>Recipe name</option>
        <option value="rating" {{#if ratingSort}}selected{{/if}}>Highest rating</option>
      </select>
    </div>
    <button class="btn btn-success" type="submit">Search</button>
    {{#if hasSearch}}<a class="recipe-filter-reset" href="{{base}}?view={{view}}&amp;sort={{sort}}">Clear search</a>{{/if}}
  </form>
