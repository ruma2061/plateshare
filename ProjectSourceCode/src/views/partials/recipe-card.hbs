<article class="card recipe-card h-100">
  <a class="recipe-card-photo" href="/recipes/{{recipe.recipe_id}}" tabindex="-1" aria-hidden="true">
    {{> recipe-photo recipe=recipe}}
    <span class="recipe-category">{{#if recipe.cuisine}}{{recipe.cuisine}}{{else}}{{recipe.categoryName}}{{/if}}</span>
  </a>
  <div class="card-body d-flex flex-column">
    <h2 class="h5"><a class="recipe-title-link" href="/recipes/{{recipe.recipe_id}}">{{recipe.title}}</a></h2>
    <p class="recipe-card-meta">By {{#if recipe.authorUrl}}<a class="recipe-author" href="{{recipe.authorUrl}}">{{recipe.author}}</a>{{else}}{{recipe.author}}{{/if}}{{#if recipe.hasTotalTime}}<span>{{> icon clock=true}} {{recipe.totalMinutes}} min</span>{{/if}}</p>
    {{#if recipe.description}}<p class="recipe-description">{{recipe.description}}</p>{{/if}}
    {{#if recipe.user_score}}<p class="recipe-card-rating">Your score: {{recipe.user_score}} / 10</p>{{else if recipe.user_rating}}<p class="recipe-card-rating">Your rating: {{recipe.user_rating}} / 5</p>{{/if}}
    <div class="mt-auto">
      {{#if recipe.hasNutrition}}{{> nutrition recipe=recipe}}{{/if}}
      <div class="recipe-card-actions">
        <a class="btn btn-outline-success btn-sm" href="/recipes/{{recipe.recipe_id}}" aria-label="View {{recipe.title}}">View recipe</a>
        {{> recipe-save recipe=recipe csrfToken=csrfToken returnTo=returnTo}}
      </div>
    </div>
  </div>
</article>
