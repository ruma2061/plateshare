<article class="card recipe-card h-100">
  {{#if recipe.image_url}}
    <img src="{{recipe.image_url}}" class="card-img-top recipe-card-image" alt="{{recipe.title}}" loading="lazy" referrerpolicy="no-referrer">
  {{else}}
    <div class="recipe-photo-placeholder" aria-hidden="true">PlateShare</div>
  {{/if}}
  <div class="card-body d-flex flex-column">
    <p class="recipe-eyebrow mb-2">{{#if recipe.cuisine}}{{recipe.cuisine}}{{else}}From the community{{/if}}</p>
    <h2 class="h5"><a class="recipe-title-link" href="/recipes/{{recipe.recipe_id}}">{{recipe.title}}</a></h2>
    <p class="small text-secondary">By {{recipe.author}}</p>
    {{#if recipe.description}}<p class="recipe-description">{{recipe.description}}</p>{{/if}}
    <p class="small fw-semibold">{{#if recipe.user_rating}}Your rating: {{recipe.user_rating}} / 5{{else}}You have not rated this recipe{{/if}}</p>
    <div class="mt-auto">
      {{> nutrition recipe=recipe}}
      <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn btn-outline-success btn-sm" href="/recipes/{{recipe.recipe_id}}">View recipe</a>
        {{> recipe-save recipe=recipe csrfToken=csrfToken returnTo=returnTo}}
      </div>
    </div>
  </div>
</article>
